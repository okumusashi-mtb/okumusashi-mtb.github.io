---
import '../styles/global.css';
import { buildInfo } from '../lib/buildinfo';
import { footerGroups } from '../data/footer-links';
import { cfBeaconToken } from '../data/analytics';
const { title, description, noindex } = Astro.props;
const base = import.meta.env.BASE_URL;
// 正規 URL は astro.config.mjs の site (GitHub Pages)。同じ成果物を Cloudflare
// Pages や Firebase Hosting にも置くことがあるため、どこから配信されても
// 「正規版はここ」と示せるよう絶対 URL を埋める。
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: base, label: 'トップ' },
  { href: base + 'activities/', label: '活動' },
  { href: base + 'about/', label: '会について' },
];
// 注: 写真ギャラリー(gallery/)は Phase B で追加するため、Phase A の nav には入れない。
---
<html lang="ja">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex
      ? <meta name="robots" content="noindex" />
      : <link rel="canonical" href={canonical} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-20 bg-[var(--color-cream)]/90 backdrop-blur border-b border-black/5">
      <nav class="mx-auto max-w-5xl px-4 py-3 flex items-center gap-4 text-sm">
        <a href={base} class="font-bold text-[var(--color-wakaba)] no-underline">奥武蔵MTB友の会</a>
        <span class="flex-1"></span>
        {nav.map((n) => <a href={n.href} class="no-underline text-[var(--color-sumi)]/80 hover:text-[var(--color-wakaba)]">{n.label}</a>)}
      </nav>
    </header>
    <main class="flex-1"><slot /></main>
    <footer class="mt-16 border-t border-black/5">
      <div class="mx-auto max-w-5xl px-4 py-10">
        <nav class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4" aria-label="サイト内および会の各種ページ">
          {footerGroups(base).map((g) => (
            <div>
              <div class="text-sm font-bold text-[var(--color-tsuchi)] tracking-wide">{g.title}</div>
              <ul class="mt-3 space-y-2">
                {g.links.map((l) => (
                  <li>
                    <a href={l.href} class="text-sm no-underline text-[var(--color-sumi)]/70 hover:text-[var(--color-wakaba)]">{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>

        <div class="mt-10 pt-6 border-t border-black/5 text-center">
          <div class="font-bold text-[var(--color-sumi)]/80">奥武蔵マウンテンバイク友の会</div>
          <address class="mt-2 not-italic text-sm text-[var(--color-sumi)]/60 leading-relaxed">
            事務局 〒357-0035 埼玉県飯能市柳町 3-11 サイクルハウス ミカミ内<br />
            Tel/Fax <a href="tel:+81429744490" class="text-[var(--color-wakaba)]">042-974-4490</a>
          </address>
          <div class="mt-6 text-xs text-[var(--color-sumi)]/45 leading-relaxed">
            このサイトは
            <a href={buildInfo.repoUrl} class="text-[var(--color-wakaba)]">{buildInfo.repo}</a>
            のデータから生成しています<br />
            <a href={buildInfo.commitUrl} class="text-[var(--color-wakaba)]"><code>{buildInfo.short}</code></a>
            <span class="ml-1">· {buildInfo.builtAt} JST ビルド</span>
          </div>
        </div>
      </div>
    </footer>
    {/* Cloudflare Web Analytics。公式 snippet に合わせて type="module" にしている
        (モジュールは既定で defer 相当なので描画を止めない)。module は CORS で取得される
        が beacon.min.js は access-control-allow-origin: * を返すので問題ない。
        is:inline で Astro のバンドル対象から外す。設定は data/analytics.ts */}
    {import.meta.env.PROD && cfBeaconToken && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js"
              data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}></script>
    )}
  </body>
</html>
