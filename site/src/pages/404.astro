---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="ページが見つかりません | 奥武蔵MTB友の会" noindex={true}>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-6xl font-bold text-[var(--color-wakaba)]">404</p>
    <h1 class="text-2xl font-bold mt-4">ページが見つかりません</h1>
    <p class="mt-4 text-[var(--color-sumi)]/70">
      お探しのページは、移動したか削除された可能性があります。
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center text-sm">
      <a href={base} class="px-4 py-2 rounded-full bg-[var(--color-wakaba)] text-white no-underline">トップへ</a>
      <a href={`${base}activities/`} class="px-4 py-2 rounded-full border no-underline text-[var(--color-sumi)]">活動アーカイブ</a>
    </div>
  </section>
</Base>
