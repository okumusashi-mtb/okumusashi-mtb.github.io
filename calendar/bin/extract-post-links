#!/usr/bin/env python3
"""extract-post-links — 記事 HTML から本文中のリンク・埋め込みを抽出し YAML に保存。

アーカイブ YAML の body はテキスト抽出なので、「クリックで地図を表示」のような
アンカーはリンク先が失われる。Wix ブログの過去コンテンツ削除に備え、記事がまだ
取得できるうちに <a href> と <iframe src> を links: / embeds: として回収するための道具。

記事 HTML を取得し `<cache-dir>` に gzip で保存する（再実行時はキャッシュを使う）。
生 HTML は 1 記事 ~0.9MB でその 95% が Wix のボイラープレートなので、リポジトリには
入れずリポジトリ外を指定して使う。抽出結果だけが YAML に入る。

  cd calendar && bin/extract-post-links ~/Documents/omc-blog-html/html-all

Wix が消えた後は取得できないため、通常の更新手順 (make update) には含めない一度限りの道具。
"""
from __future__ import annotations
import glob, gzip, html as _html, json, os, re, sys, time
import urllib.parse, urllib.request
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import omc_parse
import yaml

# Wix が全ページに埋める定型リンク。記事の内容ではないので除く。
BOILERPLATE = re.compile(r"(^|\.)(wix\.com|parastorage\.com|siteassets\.[^/]*|wixstatic\.com)$")
_TAG_RE = re.compile(r"<[^>]+>")


def _fetch(url: str) -> str:
    sp = urllib.parse.urlsplit(url)
    u2 = urllib.parse.urlunsplit(
        (sp.scheme, sp.netloc, urllib.parse.quote(sp.path), sp.query, sp.fragment))
    req = urllib.request.Request(u2, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read().decode("utf-8", "replace")


def _get_html(url: str, cache_dir: str) -> str:
    path = os.path.join(cache_dir, omc_parse.slugify_post_url(url) + ".html.gz")
    if os.path.exists(path):
        with gzip.open(path, "rt", encoding="utf-8") as f:
            return f.read()
    html = _fetch(url)
    os.makedirs(cache_dir, exist_ok=True)
    with gzip.open(path, "wt", encoding="utf-8") as f:
        f.write(html)
    time.sleep(0.3)
    return html


def body_region(html: str) -> str:
    """本文コンテナからフッタ直前まで。extract_post_body と同じ切り出し。"""
    i = html.find('data-hook="post-description"')
    if i == -1:
        return ""
    e = html.find("Proudly created with Wix", i)
    return html[i:e] if e > i else html[i:]


def _is_boilerplate(url: str) -> bool:
    if url.startswith("mailto:"):
        return False
    return bool(BOILERPLATE.search(urllib.parse.urlsplit(url).hostname or ""))


def extract_links(html: str) -> dict:
    """本文領域の <a href> と <iframe src> を出現順・重複なしで返す。"""
    region = body_region(html)
    links, embeds = [], []
    seen_l, seen_e = set(), set()
    for m in re.finditer(r'<a\b[^>]*href="([^"]+)"[^>]*>(.*?)</a>', region, re.S):
        url = _html.unescape(m.group(1)).strip()
        if not re.match(r"(https?:|mailto:)", url) or _is_boilerplate(url) or url in seen_l:
            continue
        seen_l.add(url)
        text = re.sub(r"\s+", " ", _html.unescape(_TAG_RE.sub("", m.group(2)))).strip()
        links.append({"text": text, "url": url} if text else {"url": url})
    for m in re.finditer(r'<iframe\b[^>]*\bsrc="([^"]+)"', region, re.S):
        url = _html.unescape(m.group(1)).strip()
        if not url.startswith("http") or _is_boilerplate(url) or url in seen_e:
            continue
        seen_e.add(url)
        embeds.append(url)
    return {"links": links, "embeds": embeds}


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__.strip().splitlines()[0], file=sys.stderr)
        print("usage: extract-post-links <cache-dir> [archive-dir]", file=sys.stderr)
        return 2
    cache_dir = os.path.expanduser(sys.argv[1])
    archive_dir = sys.argv[2] if len(sys.argv) > 2 else "sources/blog"

    posts = fails = with_links = with_embeds = 0
    for path in sorted(glob.glob(os.path.join(archive_dir, "*.yaml"))):
        orig = open(path, encoding="utf-8").read()
        rec = yaml.safe_load(orig)
        if not rec or not rec.get("url"):
            continue
        posts += 1
        try:
            html = _get_html(rec["url"], cache_dir)
        except Exception as e:
            fails += 1
            print(f"  skip {os.path.basename(path)}: {type(e).__name__}", file=sys.stderr)
            continue
        got = extract_links(html)
        rec.pop("links", None)
        rec.pop("embeds", None)
        if got["links"]:
            rec["links"] = got["links"]
            with_links += 1
        if got["embeds"]:
            rec["embeds"] = got["embeds"]
            with_embeds += 1
        new = omc_parse.dump_archive_yaml(rec)
        if new != orig:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(new)
    print(f"posts={posts} fetch_failed={fails} with_links={with_links} with_embeds={with_embeds}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
